<CourseScreenView>:
    theme_bg_color: "Custom"
    md_bg_color: app.theme_cls.primaryColor
    MDBoxLayout:
        orientation:"vertical"
        MDTopAppBar:
            padding:"10dp"
            theme_bg_color:"Custom"
            md_bg_color:app.theme_cls.tertiaryContainerColor
            MDTopAppBarTitle:
                text:"Courses"
        MDScrollView:
            orientation:"vertical"
            _do_scroll_x:False
            MDBoxLayout:
                orientation:"vertical"
                adaptive_height:True
                spacing:"15dp"
                padding:"10dp"
                MDCard:
                    size_hint_x:1
                    size_hint_y:None
                    height : self.width * 9 / 16
                    MDFloatLayout:
                        padding:"5dp"
                        FitImage:
                            radius:"15dp"
                            size_hint:1,1
                            pos_hint:{"x":0,"y":0}
                            source:"./assets/images/Anatomy_Cover_Image.jpg"
                        MDCard:
                            style:"filled"
                            theme_bg_color:"Custom"
                            size_hint:1,1
                            pos_hint:{"x":0,"y":0}
                            md_bg_color:[0,0,0,.35]
                            radius:"15dp"
                        MDLabel:
                            text:"Anatomy"
                            font_style:"Headline"
                            role:"large"
                            halign:"center"
                            valign:"middle"
                            size_hint:1,1
                            pos_hint:{"x":0,"y":0}
                            theme_text_color:"Custom"
                            text_color:app.theme_cls.tertiaryContainerColor

                MDCard:
                    size_hint_x:1
                    size_hint_y:None
                    height : self.width * 9 / 16
                    MDFloatLayout:
                        padding:"5dp"
                        FitImage:
                            radius:"15dp"
                            size_hint:1,1
                            pos_hint:{"x":0,"y":0}
                            source:"./assets/images/Physiology_Cover_Image.jpg"
                        MDCard:
                            style:"filled"
                            theme_bg_color:"Custom"
                            size_hint:1,1
                            pos_hint:{"x":0,"y":0}
                            md_bg_color:[0,0,0,.35]
                            radius:"15dp"
                        MDLabel:
                            text:"Physiology"
                            font_style:"Headline"
                            role:"medium"
                            halign:"center"
                            valign:"middle"
                            size_hint:1,1
                            pos_hint:{"x":0,"y":0}
                            theme_text_color:"Custom"
                            text_color:app.theme_cls.tertiaryContainerColor

                MDCard:
                    size_hint_x:1
                    size_hint_y:None
                    height : self.width * 9 / 16
                    MDFloatLayout:
                        padding:"5dp"
                        FitImage:
                            radius:"15dp"
                            size_hint:1,1
                            pos_hint:{"x":0,"y":0}
                            source:"./assets/images/Biochemistry_Cover_Image.jpg"
                        MDCard:
                            style:"filled"
                            theme_bg_color:"Custom"
                            size_hint:1,1
                            pos_hint:{"x":0,"y":0}
                            md_bg_color:[0,0,0,.35]
                            radius:"15dp"
                        MDLabel:
                            text:"Biochemistry"
                            font_style:"Headline"
                            role:"medium"
                            halign:"center"
                            valign:"middle"
                            size_hint:1,1
                            pos_hint:{"x":0,"y":0}
                            theme_text_color:"Custom"
                            text_color:app.theme_cls.tertiaryContainerColor
