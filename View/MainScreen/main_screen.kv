<BaseMDNavigationItem@MDNavigationItem>:


<MainScreenView>:
    theme_bg_color: "Custom"
    md_bg_color: app.theme_cls.tertiaryContainerColor
    padding:"15dp"
    MDBoxLayout:
        orientation:"vertical"
        MDTopAppBar:
            theme_bg_color:"Custom"
            md_bg_color:app.theme_cls.tertiaryContainerColor
            MDTopAppBarTitle:
                text:"Home"
                halign:"center"
        MDCard:
            theme_bg_color:"Custom"
            md_bg_color:app.theme_cls.tertiaryContainerColor
            size_hint_y:.3
            radius:[0,"15dp","15dp",0]
            state_press:0
            ripple_effect:False
            focus_behavior:False
            button_behavior:False
            AnimatedLabel:
                id:title_text
                markup:True
                font_style:"Headline"
                role:"small"
                text:""
                text_color:"#202016"
                halign:"center"