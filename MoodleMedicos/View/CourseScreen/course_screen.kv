<CourseScreenView>:
    theme_bg_color: "Custom"
    md_bg_color: app.theme_cls.tertiaryContainerColor
    MDBoxLayout:
        orientation:"vertical"
        MDTopAppBar:
            padding:"10dp"
            MDTopAppBarLeadingButtonContainer:
                MDButton:
                    radius:0,"20dp",0,"20dp"
                    MDButtonText:
                        text:"Select Course"
        MDLabel:
            text:"Courses"
            halign:"center"
            valign:"center"

